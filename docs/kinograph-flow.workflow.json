  "cards": [
    {
      "dot": "rose",
      "title": "Nothing unchecked ships",
      "items": [
        "A FIX or NOT CHECKED row renames the file .rejected.mp4",
        "A run that breaks leaves .unchecked.mp4; neither is delivered"
      ]
    },
    {
      "dot": "cyan",
      "title": "Reviews stay independent",
      "items": [
        "Each round gets a new reviewer id and never the builder report",
        "Fix rounds stop at three with a P0 open, two for P1 and P2"
      ]
    },
    {
      "dot": "amber",
      "title": "Approval is pinned",
      "items": [
        "qa.py approve keeps hashes of the file and key frames",
        "A later change marks it stale (Q1301) until it is approved again"
      ]
    },
    {
      "dot": "emerald",
      "title": "58 Q codes",
      "items": [
        "One table in contract.py names every code",
        "qa.py selftest plants a fault for each one"
      ]
    }
  ]
